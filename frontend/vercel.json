{
  "rewrites": [
    {
      "source": "/observations/:path*",
      "destination": "https://monitor-secchia-backend.onrender.com/observations/:path*"
    },
    {
      "source": "/alerts/:path*",
      "destination": "https://monitor-secchia-backend.onrender.com/alerts/:path*"
    },
    {
      "source": "/reports/:path*",
      "destination": "https://monitor-secchia-backend.onrender.com/reports/:path*"
    },
    {
      "source": "/stations/:path*",
      "destination": "https://monitor-secchia-backend.onrender.com/stations/:path*"
    },
    {
      "source": "/stations",
      "destination": "https://monitor-secchia-backend.onrender.com/stations"
    }
  ]
}
